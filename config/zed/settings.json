// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "context_servers": {
    "mcp-server-github": {
      "enabled": true,
      "remote": false,
      "settings": {
        "github_personal_access_token": "<TOKEN>"
      }
    }
  },
  "show_signature_help_after_edits": false,
  "colorize_brackets": false,
  "code_lens": "off",
  "languages": {
    "Python": {
      "prettier": {
        "allowed": false
      },
      "colorize_brackets": false,
      "inlay_hints": {
        "show_background": false,
        "enabled": false
      },
      "completions": {
        "words": "fallback"
      },
      "indent_guides": {
        "background_coloring": "disabled",
        "coloring": "indent_aware"
      },
      "soft_wrap": "none"
    }
  },
  "hover_popover_delay": 100,
  "proxy": "",
  "show_edit_predictions": true,
  "edit_predictions": {
    "provider": "open_ai_compatible_api",
    "open_ai_compatible_api": {
      "model": "openai/gpt-oss-120b:nitro",
      "api_url": "https://openrouter.ai/api/v1"
    },
    "allow_data_collection": "no"
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "agent": {
    "sandbox_permissions": {
      "network_hosts": [
        "github.com",
        "codeload.github.com",
        "api.github.com"
      ]
    },
    "tool_permissions": {
      "tools": {
        "fetch": {
          "default": "allow"
        },
        "mcp:mcp-server-github:issue_write": {
          "default": "allow"
        },
        "create_directory": {
          "default": "allow"
        },
        "mcp:mcp-server-github:get_file_contents": {
          "default": "allow"
        },
        "mcp:mcp-server-github:get_me": {
          "default": "allow"
        },
        "skill": {
          "default": "allow"
        },
        "terminal": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^mkdir\\b"
            },
            {
              "pattern": "^cd\\s+frontend(\\s|$)"
            },
            {
              "pattern": "^npm\\s+run(\\s|$)"
            },
            {
              "pattern": "^npx\\s+svelte-check(\\s|$)"
            },
            {
              "pattern": "^head\\b"
            },
            {
              "pattern": "^npx\\s+vite(\\s|$)"
            },
            {
              "pattern": "^tail\\b"
            }
          ]
        }
      }
    },
    "sidebar_side": "right",
    "default_profile": "write",
    "default_model": {
      "effort": "low",
      "provider": "openrouter",
      "model": "~deepseek/deepseek-flash-latest",
      "enable_thinking": true
    },
    "dock": "right",
    "favorite_models": [
      {
        "provider": "openrouter",
        "model": "z-ai/glm-5.3-flash",
        "enable_thinking": true,
        "effort": "max"
      }
    ],
    "model_parameters": []
  },
  "project_panel": {
    "git_status_indicator": true,
    "diagnostic_badges": true,
    "bold_folder_labels": true,
    "dock": "left"
  },
  "preview_tabs": {
    "enable_preview_from_file_finder": false
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": false
  },
  "tabs": {
    "file_icons": true,
    "git_status": true
  },
  "title_bar": {
    "show_menus": false,
    "show_branch_status_icon": false
  },
  "status_bar": {
    "show_active_file": true
  },
  "agent_servers": {
    
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "base_keymap": "JetBrains",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
}
